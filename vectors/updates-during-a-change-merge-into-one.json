{
  "name": "updates-during-a-change-merge-into-one",
  "description": "Updates that arrive while a change goes out wait, and merge into one change (SPEC \u00a73.3).",
  "protocols": [
    "sotw",
    "delta"
  ],
  "serves": [
    "CDS"
  ],
  "envoys": [
    {
      "name": "envoy",
      "view": "v"
    }
  ],
  "steps": [
    {
      "update": [
        {
          "setView": "v",
          "groups": [
            "g"
          ]
        },
        {
          "editGroup": "g",
          "put": {
            "CDS": [
              {
                "name": "a",
                "connectTimeout": "1s"
              }
            ]
          }
        }
      ]
    },
    {
      "request": "CDS",
      "expect": [
        {
          "type": "CDS",
          "resources": [
            {
              "name": "a",
              "connectTimeout": "1s"
            }
          ]
        }
      ]
    },
    {
      "request": "CDS",
      "ack": "last"
    },
    {
      "update": [
        {
          "editGroup": "g",
          "put": {
            "CDS": [
              {
                "name": "b",
                "connectTimeout": "1s"
              }
            ]
          }
        }
      ],
      "expect": [
        {
          "type": "CDS",
          "sotw": {
            "resources": [
              {
                "name": "a",
                "connectTimeout": "1s"
              },
              {
                "name": "b",
                "connectTimeout": "1s"
              }
            ]
          },
          "delta": {
            "resources": [
              {
                "name": "b",
                "connectTimeout": "1s"
              }
            ]
          },
          "comment": "Goes out"
        }
      ]
    },
    {
      "update": [
        {
          "editGroup": "g",
          "put": {
            "CDS": [
              {
                "name": "c",
                "connectTimeout": "1s"
              }
            ]
          }
        }
      ],
      "comment": "Waits for this change"
    },
    {
      "update": [
        {
          "editGroup": "g",
          "put": {
            "CDS": [
              {
                "name": "d",
                "connectTimeout": "1s"
              }
            ]
          }
        }
      ],
      "comment": "Waits too"
    },
    {
      "request": "CDS",
      "ack": "last",
      "expect": [
        {
          "type": "CDS",
          "sotw": {
            "resources": [
              {
                "name": "a",
                "connectTimeout": "1s"
              },
              {
                "name": "b",
                "connectTimeout": "1s"
              },
              {
                "name": "c",
                "connectTimeout": "1s"
              },
              {
                "name": "d",
                "connectTimeout": "1s"
              }
            ]
          },
          "delta": {
            "resources": [
              {
                "name": "c",
                "connectTimeout": "1s"
              },
              {
                "name": "d",
                "connectTimeout": "1s"
              }
            ]
          },
          "comment": "Both, merged into one change"
        }
      ]
    },
    {
      "request": "CDS",
      "ack": "last"
    }
  ]
}
