{
  "name": "delay-updates-until-ack-of-releases-changes-on-the-first-ack",
  "description": "delayUpdatesUntilAckOf holds changes until the Envoy first ACKs an answer of that type, and no longer (SPEC \u00a73.2).",
  "protocols": [
    "sotw",
    "delta"
  ],
  "serves": [
    "CDS",
    "RDS"
  ],
  "envoys": [
    {
      "name": "envoy",
      "view": "v",
      "delayUpdatesUntilAckOf": "RDS"
    }
  ],
  "steps": [
    {
      "update": [
        {
          "setView": "v",
          "groups": [
            "g"
          ]
        },
        {
          "editGroup": "g",
          "put": {
            "CDS": [
              {
                "name": "a",
                "connectTimeout": "1s"
              }
            ],
            "RDS": [
              {
                "name": "r",
                "virtualHosts": [
                  {
                    "name": "vh",
                    "domains": [
                      "*"
                    ],
                    "routes": [
                      {
                        "match": {
                          "prefix": "/"
                        },
                        "route": {
                          "cluster": "a"
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "request": "CDS",
      "expect": [
        {
          "type": "CDS",
          "resources": [
            {
              "name": "a",
              "connectTimeout": "1s"
            }
          ]
        }
      ]
    },
    {
      "request": "CDS",
      "ack": "last",
      "comment": "An ACK, but not of RDS"
    },
    {
      "update": [
        {
          "editGroup": "g",
          "put": {
            "CDS": [
              {
                "name": "b",
                "connectTimeout": "1s"
              }
            ]
          }
        }
      ],
      "comment": "Held: no RDS ACK yet"
    },
    {
      "request": "RDS",
      "subscribe": [
        "r"
      ],
      "expect": [
        {
          "type": "RDS",
          "resources": [
            {
              "name": "r",
              "virtualHosts": [
                {
                  "name": "vh",
                  "domains": [
                    "*"
                  ],
                  "routes": [
                    {
                      "match": {
                        "prefix": "/"
                      },
                      "route": {
                        "cluster": "a"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "request": "RDS",
      "ack": "last",
      "expect": [
        {
          "type": "CDS",
          "sotw": {
            "resources": [
              {
                "name": "a",
                "connectTimeout": "1s"
              },
              {
                "name": "b",
                "connectTimeout": "1s"
              }
            ]
          },
          "delta": {
            "resources": [
              {
                "name": "b",
                "connectTimeout": "1s"
              }
            ]
          },
          "comment": "The first RDS ACK releases it"
        }
      ]
    },
    {
      "request": "CDS",
      "ack": "last"
    }
  ]
}
