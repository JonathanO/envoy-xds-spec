{
  "name": "delay-updates-until-ack-of-is-ignored-for-a-type-subscribes-to-leaves-out",
  "description": "delayUpdatesUntilAckOf naming a type the Envoy's subscribesTo leaves out is ignored (SPEC \u00a73.2).",
  "protocols": [
    "sotw",
    "delta"
  ],
  "serves": [
    "CDS",
    "RDS"
  ],
  "envoys": [
    {
      "name": "envoy",
      "view": "v",
      "delayUpdatesUntilAckOf": "RDS",
      "subscribesTo": [
        "CDS"
      ]
    }
  ],
  "steps": [
    {
      "update": [
        {
          "setView": "v",
          "groups": [
            "g"
          ]
        },
        {
          "editGroup": "g",
          "put": {
            "CDS": [
              {
                "name": "a",
                "connectTimeout": "1s"
              }
            ]
          }
        }
      ]
    },
    {
      "request": "CDS",
      "expect": [
        {
          "type": "CDS",
          "resources": [
            {
              "name": "a",
              "connectTimeout": "1s"
            }
          ]
        }
      ]
    },
    {
      "request": "CDS",
      "ack": "last"
    },
    {
      "update": [
        {
          "editGroup": "g",
          "put": {
            "CDS": [
              {
                "name": "b",
                "connectTimeout": "1s"
              }
            ]
          }
        }
      ],
      "expect": [
        {
          "type": "CDS",
          "sotw": {
            "resources": [
              {
                "name": "a",
                "connectTimeout": "1s"
              },
              {
                "name": "b",
                "connectTimeout": "1s"
              }
            ]
          },
          "delta": {
            "resources": [
              {
                "name": "b",
                "connectTimeout": "1s"
              }
            ]
          },
          "comment": "Not held"
        }
      ]
    },
    {
      "request": "CDS",
      "ack": "last"
    }
  ]
}
