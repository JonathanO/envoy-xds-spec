{
  "name": "delta-kept-resource-that-still-exists-is-sent-again",
  "description": "A resource a reconnecting delta Envoy kept that still exists is sent again: ports compare names, not versions (SPEC \u00a76.1).",
  "protocols": [
    "delta"
  ],
  "serves": [
    "CDS"
  ],
  "envoys": [
    {
      "name": "envoy",
      "view": "v"
    }
  ],
  "steps": [
    {
      "update": [
        {
          "setView": "v",
          "groups": [
            "g"
          ]
        },
        {
          "editGroup": "g",
          "put": {
            "CDS": [
              {
                "name": "a",
                "connectTimeout": "1s"
              }
            ]
          }
        }
      ]
    },
    {
      "request": "CDS",
      "kept": [
        "a"
      ],
      "expect": [
        {
          "type": "CDS",
          "resources": [
            {
              "name": "a",
              "connectTimeout": "1s"
            }
          ]
        }
      ]
    }
  ]
}
